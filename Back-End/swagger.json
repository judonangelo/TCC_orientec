{
  "openapi": "3.0.0",
  "info": {
    "title": "API Orientec",
    "version": "1.0.0",
    "description": "Documentação completa das rotas da API Orientec"
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor Atual"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/cadastro": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Cadastra um novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "senha", "nome", "cpf"],
                "properties": {
                  "nome": { "type": "string", "example": "João Silva" },
                  "email": { "type": "string", "example": "joao@email.com" },
                  "cpf": { "type": "string", "example": "12345678901" },
                  "senha": { "type": "string", "example": "senha123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário cadastrado com sucesso!" },
          "400": { "description": "Dados inválidos ou e-mail/CPF já cadastrados." },
          "500": { "description": "Erro interno do servidor." }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Realiza login do usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "senha"],
                "properties": {
                  "email": { "type": "string", "example": "joao@email.com" },
                  "senha": { "type": "string", "example": "senha123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login realizado com sucesso e retorna o token JWT." },
          "401": { "description": "Usuário ou senha inválidos." },
          "500": { "description": "Erro interno do servidor." }
        }
      }
    },
    "/alterar_senha": {
      "put": {
        "tags": ["Autenticação"],
        "summary": "Altera a senha do usuário logado",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["senhaAtual", "novaSenha"],
                "properties": {
                  "senhaAtual": { "type": "string", "example": "senha123" },
                  "novaSenha": { "type": "string", "example": "novaSenha123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Senha alterada com sucesso." },
          "400": { "description": "Campos inválidos." },
          "401": { "description": "Token inválido ou senha atual incorreta." },
          "500": { "description": "Erro interno do servidor." }
        }
      }
    },
    "/redefinir_senha_sem_email": {
      "put": {
        "tags": ["Autenticação"],
        "summary": "Redefine a senha validadndo e-mail e CPF",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "cpf", "novaSenha"],
                "properties": {
                  "email": { "type": "string", "example": "joao@email.com" },
                  "cpf": { "type": "string", "example": "12345678901" },
                  "novaSenha": { "type": "string", "example": "novaSenha123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Senha redefinida com sucesso." },
          "400": { "description": "Dados incorretos ou não informados." },
          "500": { "description": "Erro interno do servidor." }
        }
      }
    },
    "/perfil": {
      "get": {
        "tags": ["Perfil"],
        "summary": "Busca dados do perfil do usuário logado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dados do usuário retornado." },
          "401": { "description": "Não autorizado." },
          "404": { "description": "Usuário não encontrado." }
        }
      }
    },
    "/perfil/foto": {
      "put": {
        "tags": ["Perfil"],
        "summary": "Atualiza a foto de perfil do usuário logado",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "foto": { "type": "string", "nullable": true, "example": "data:image/jpeg;base64,..." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Foto atualizada com sucesso!" },
          "401": { "description": "Não autorizado." }
        }
      }
    },
    "/cursos": {
      "get": {
        "tags": ["Cursos"],
        "summary": "Lista todos os cursos",
        "responses": {
          "200": { "description": "Lista de cursos." }
        }
      },
      "post": {
        "tags": ["Cursos"],
        "summary": "Cria um novo curso (Admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nome", "duracao", "vagas", "status"],
                "properties": {
                  "nome": { "type": "string", "example": "Desenvolvimento de Sistemas" },
                  "duracao": { "type": "string", "example": "3 semestres" },
                  "vagas": { "type": "integer", "example": 40 },
                  "status": { "type": "string", "example": "ativo" },
                  "descricao": { "type": "string" },
                  "area": { "type": "string" },
                  "resumo": { "type": "string" },
                  "carga_horaria": { "type": "string" },
                  "salario": { "type": "string" },
                  "mercado": { "type": "string" },
                  "perfil": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Curso criado com sucesso." },
          "403": { "description": "Acesso restrito a administradores." }
        }
      }
    },
    "/cursos/{id}": {
      "get": {
        "tags": ["Cursos"],
        "summary": "Busca um curso específico pelo ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Curso encontrado." },
          "404": { "description": "Curso não encontrado." }
        }
      },
      "put": {
        "tags": ["Cursos"],
        "summary": "Atualiza um curso (Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nome", "duracao", "vagas", "status"],
                "properties": {
                  "nome": { "type": "string" },
                  "duracao": { "type": "string" },
                  "vagas": { "type": "integer" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Curso atualizado." },
          "404": { "description": "Curso não encontrado." }
        }
      },
      "delete": {
        "tags": ["Cursos"],
        "summary": "Exclui um curso (Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Curso excluído com sucesso." },
          "404": { "description": "Curso não encontrado." }
        }
      }
    },
    "/perguntas": {
      "get": {
        "tags": ["Teste Vocacional"],
        "summary": "Lista todas as perguntas do teste vocacional",
        "responses": {
          "200": { "description": "Lista de perguntas com respostas." }
        }
      },
      "post": {
        "tags": ["Teste Vocacional"],
        "summary": "Cadastra uma pergunta com opções de respostas (Admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pergunta", "respostas"],
                "properties": {
                  "pergunta": { "type": "string", "example": "Você prefere exatas ou humanas?" },
                  "respostas": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "texto": { "type": "string", "example": "Exatas" },
                        "pesos": { "type": "object", "example": { "ti": 5, "mecanica": 3 } }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Pergunta cadastrada com sucesso." },
          "400": { "description": "Dados insuficientes." }
        }
      }
    },
    "/perguntas/{id}": {
      "put": {
        "tags": ["Teste Vocacional"],
        "summary": "Atualiza uma pergunta e suas respostas (Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Pergunta atualizada com sucesso." }
        }
      },
      "delete": {
        "tags": ["Teste Vocacional"],
        "summary": "Exclui uma pergunta (Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Pergunta excluída com sucesso." },
          "404": { "description": "Pergunta não encontrada." }
        }
      }
    },
    "/relatorios": {
      "get": {
        "tags": ["Administrador"],
        "summary": "Exibe relatórios gerais do sistema (Admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Estatísticas obtidas com sucesso." },
          "403": { "description": "Acesso negado." }
        }
      }
    },
    "/usuarios": {
      "get": {
        "tags": ["Administrador"],
        "summary": "Lista todos os usuários cadastrados (Admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Lista de usuários." }
        }
      }
    },
    "/usuarios/{id}": {
      "put": {
        "tags": ["Administrador"],
        "summary": "Altera o nível de acesso do usuário (Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nivel"],
                "properties": {
                  "nivel": { "type": "string", "example": "admin" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Nível do usuário atualizado." },
          "404": { "description": "Usuário não encontrado." }
        }
      },
      "delete": {
        "tags": ["Administrador"],
        "summary": "Deleta um usuário do sistema (Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Usuário excluído com sucesso." },
          "404": { "description": "Usuário não encontrado." }
        }
      }
    }
  }
}